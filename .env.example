# ローカル開発用。.env.local にコピーして値を入れる（.env.local はコミットしない）
DATABASE_URL=postgres://confidently:confidently@localhost:5432/confidently

# Better Auth。BETTER_AUTH_SECRET は `openssl rand -base64 32` などで作る
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth（Google Cloud Console で作成。リダイレクト URI は
# http://localhost:3000/api/auth/callback/google）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 統合テスト（pnpm test:integration）の接続先。省略すると docker の同じコンテナの confidently_test を使う
# （なければ作ってマイグレーションを当てる）。DB 名が _test で終わらない接続先は拒否する（CI を除く）
# TEST_DATABASE_URL=postgres://confidently:confidently@localhost:5432/confidently_test
